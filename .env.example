# Настройка базы данных для серверной части
POSTGRES_USER=postgres #?< Change >
POSTGRES_PASSWORD=0000 #?< Change >
POSTGRES_DB=SiMed-db
POSTGRES_HOST=localhost
POSTGRES_PORT=25432

# Начальный admin-пользователь. Пароль должен соответствовать Identity password policy.
SSO_ADMIN_EMAIL=admin@simed.local
SSO_ADMIN_PASSWORD=ChangeMe!123
SSO_ISSUER=https://localhost:7269/

# Production OIDC certificates
# В Development используются OpenIddict development certificates.
# Для Staging/Production dev-сертификаты использовать нельзя: задайте отдельные .pfx файлы.
# Пути могут быть абсолютными или относительными к корню приложения.
# OIDC_SIGNING_CERT_PATH=certs/oidc-signing.pfx
# OIDC_SIGNING_CERT_PASSWORD=change-this-signing-password
# OIDC_ENCRYPTION_CERT_PATH=certs/oidc-encryption.pfx
# OIDC_ENCRYPTION_CERT_PASSWORD=change-this-encryption-password

# Параметры SMTP
# Без настроенной SMTP службы не будет работать регистрация/авторизация по почте
SSO_REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.gmail.com #*< Optional >
SMTP_PORT=587
SMTP_USERNAME=user@mail.com #*< Optional >
SMTP_PASSWORD=userpass #*< Optional >
FROM_EMAIL=your@mail.com
FROM_NAME=SiMed

# Параметры для PGAdmin
# Изменение стандартных параметров рекомендовано в целях безопасности
PGADMIN_PORT=8081
PGADMIN_DEFAULT_EMAIL=pgadmin@mail.com #?< Change >
PGADMIN_DEFAULT_PASSWORD=pgadminpass #?< Change >
