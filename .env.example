# Настройка базы данных для серверной части
POSTGRES_USER=postgres #?< Change >
POSTGRES_PASSWORD=0000 #?< Change >
POSTGRES_DB=SiMed-db
POSTGRES_HOST=localhost
POSTGRES_PORT=25432

# Initial admin user. Password must match Identity password policy.
SSO_ADMIN_EMAIL=admin@simed.local
SSO_ADMIN_PASSWORD=ChangeMe!123

# Параметры SMTP
# Без настроенной SMTP службы не будет работать регистрация/авторизация по почте
SSO_REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.gmail.com #*< Optional >
SMTP_PORT=587
SMTP_USERNAME=user@mail.com #*< Optional >
SMTP_PASSWORD=userpass #*< Optional >
FROM_EMAIL=your@mail.com
FROM_NAME=SiMed

# Параметры для PGAdmin
# Изменение стандартных параметров рекомендовано в целях безопасности
PGADMIN_PORT=8081
PGADMIN_DEFAULT_EMAIL=pgadmin@mail.com #?< Change >
PGADMIN_DEFAULT_PASSWORD=pgadminpass #?< Change >
