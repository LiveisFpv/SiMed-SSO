@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="py-4">
    <h1 class="h3 mb-3">SiMed SSO Sample Client</h1>
    <p class="text-muted">
        Шаблон показывает локальных пользователей приложения и вход через SiMed SSO по Authorization Code Flow with PKCE.
    </p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-success" role="alert">
            Вы вошли как <strong>@(User.Identity.Name ?? "пользователь")</strong>.
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-page="/Profile">Открыть профиль</a>
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="btn btn-outline-secondary">Выйти</button>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Можно войти локально по email/password или через SiMed SSO. При первом SSO-входе локальный пользователь будет создан автоматически.
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-page="/Account/Login">Войти</a>
            <a class="btn btn-outline-primary" asp-page="/Account/Register">Зарегистрироваться</a>
        </div>
    }
</div>
