@page
@model ProfileModel
@{
    ViewData["Title"] = "Профиль";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Профиль SampleClient</h1>
        <p class="text-muted mb-0">Локальный пользователь, связка с SiMed SSO, token summary и UserInfo.</p>
    </div>
    <form method="post" asp-page="/Account/Logout">
        <button type="submit" class="btn btn-outline-secondary">Выйти</button>
    </form>
</div>

@if (Model.LocalUser is not null)
{
    <section class="mb-4">
        <h2 class="h5">Локальный пользователь</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9"><code>@Model.LocalUser.Id</code></dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.LocalUser.Email</dd>

            <dt class="col-sm-3">Имя</dt>
            <dd class="col-sm-9">@(Model.LocalUser.DisplayName ?? "-")</dd>

            <dt class="col-sm-3">Email подтвержден</dt>
            <dd class="col-sm-9">@(Model.LocalUser.EmailConfirmed ? "Да" : "Нет")</dd>

            <dt class="col-sm-3">Локальный пароль</dt>
            <dd class="col-sm-9">@(Model.LocalUser.HasPassword ? "Есть" : "Нет")</dd>

            <dt class="col-sm-3">SiMed SSO</dt>
            <dd class="col-sm-9">@(Model.LocalUser.HasSiMedSsoLogin ? "Привязан" : "Не привязан")</dd>

            <dt class="col-sm-3">SSO subject</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.LocalUser.SsoSubject) ? "-" : Model.LocalUser.SsoSubject)</dd>

            <dt class="col-sm-3">Создан</dt>
            <dd class="col-sm-9">@Model.LocalUser.CreatedAtUtc.UtcDateTime.ToString("u")</dd>

            <dt class="col-sm-3">Последний вход</dt>
            <dd class="col-sm-9">@(Model.LocalUser.LastLoginAtUtc?.UtcDateTime.ToString("u") ?? "-")</dd>
        </dl>
    </section>
}

<section class="mb-4">
    <h2 class="h5">SSO tokens</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Token</th>
                    <th>Есть</th>
                    <th>Длина</th>
                    <th>Preview</th>
                    <th>Expires at</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in Model.Tokens)
                {
                    <tr>
                        <td><code>@token.Name</code></td>
                        <td>@(token.IsPresent ? "Да" : "Нет")</td>
                        <td>@token.Length</td>
                        <td><code>@token.Preview</code></td>
                        <td>@(token.ExpiresAt ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="mb-4">
    <h2 class="h5">UserInfo</h2>
    @if (Model.UserInfo is null)
    {
        <div class="alert alert-warning" role="alert">Access token отсутствует. Войдите через SiMed SSO, чтобы вызвать UserInfo.</div>
    }
    else
    {
        <div class="mb-2">
            <span class="badge @(Model.UserInfo.IsSuccess ? "text-bg-success" : "text-bg-danger")">
                HTTP @Model.UserInfo.StatusCode
            </span>
        </div>
        <pre class="border rounded p-3 bg-light"><code>@Model.UserInfo.Body</code></pre>
    }
</section>

<section>
    <h2 class="h5">Claims</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model.Claims)
                {
                    <tr>
                        <td><code>@claim.Type</code></td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
