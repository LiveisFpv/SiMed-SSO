@page
@model ResendEmailConfirmationModel

@{
    ViewData["Title"] = "Повторить подтверждение email";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Повторить подтверждение email</h1>

        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-info" role="alert">@statusMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Отправить ссылку</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
