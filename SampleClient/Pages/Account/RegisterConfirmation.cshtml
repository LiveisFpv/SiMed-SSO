@page
@model RegisterConfirmationModel

@{
    ViewData["Title"] = "Регистрация создана";
}

<div class="text-center py-5">
    <h1 class="h3 mb-3">Аккаунт создан</h1>
    <p class="text-muted mb-4">
        Если включено подтверждение email, ссылка подтверждения отправлена для @Model.Email.
        В Development ссылка логируется в консоль приложения.
    </p>
    <a class="btn btn-primary" asp-page="/Account/Login">К входу</a>
</div>
