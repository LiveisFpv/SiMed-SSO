@page
@model ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Письмо отправлено";
}

<div class="text-center py-5">
    <h1 class="h3 mb-3">Проверьте почту</h1>
    <p class="text-muted">
        Если аккаунт существует и email подтвержден, ссылка для восстановления пароля отправлена.
    </p>
    <a class="btn btn-primary" asp-page="/Account/Login">К входу</a>
</div>
