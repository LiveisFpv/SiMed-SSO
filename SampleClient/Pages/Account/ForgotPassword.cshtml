@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Восстановление пароля</h1>

        <p class="text-muted">
            Укажите email локального аккаунта SampleClient. Если аккаунт существует, ссылка для сброса пароля будет отправлена.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Отправить ссылку</button>
        </form>

        <div class="mt-3">
            <a asp-page="/Account/Login">Вернуться ко входу</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
