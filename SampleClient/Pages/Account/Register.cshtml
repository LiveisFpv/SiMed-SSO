@page
@model RegisterModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Локальная регистрация</h1>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input asp-for="Input.ReturnUrl" type="hidden" />

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
        </form>

        <form class="mt-3" method="post" asp-page="/Account/ExternalLogin">
            <input name="provider" type="hidden" value="@SampleClientAuthenticationSchemes.SiMedSso" />
            <input name="returnUrl" type="hidden" value="@Model.Input.ReturnUrl" />
            <button type="submit" class="btn btn-outline-primary w-100">Зарегистрироваться через SiMed SSO</button>
        </form>

        <div class="mt-3">
            <a asp-page="/Account/Login" asp-route-returnUrl="@Model.Input.ReturnUrl">Уже есть аккаунт</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
