@page

@{
    ViewData["Title"] = "Password reset sent";
}

<div class="text-center py-5">
    <h1 class="h3 mb-3">Check your email</h1>
    <p class="text-muted mb-4">If the account exists, a password reset link has been sent.</p>
    <a class="btn btn-primary" asp-page="/Account/Login">Back to login</a>
</div>
