@page
@model RegisterConfirmationModel

@{
    ViewData["Title"] = "Confirm email";
}

<div class="text-center py-5">
    <h1 class="h3 mb-3">Confirm your email</h1>
    <p class="text-muted mb-4">A confirmation link was sent to @Model.Email.</p>
    <a class="btn btn-outline-primary" asp-page="/Account/ResendEmailConfirmation">Resend confirmation</a>
</div>
