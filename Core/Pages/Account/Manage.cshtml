@page
@model ManageModel

@{
    ViewData["Title"] = "Account";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Account</h1>
        <p class="text-muted mb-0">@Model.Account.Email</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Account/Manage/Mfa">MFA</a>
        <a class="btn btn-outline-primary" asp-page="/Account/ChangeEmail">Change email</a>
        <a class="btn btn-outline-primary" asp-page="/Account/ChangePassword">Change password</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">User name</dt>
    <dd class="col-sm-9">@Model.Account.UserName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Account.Email</dd>

    <dt class="col-sm-3">Email confirmed</dt>
    <dd class="col-sm-9">@(Model.Account.EmailConfirmed ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(Model.Account.PhoneNumber ?? "Not set")</dd>

    <dt class="col-sm-3">MFA enabled</dt>
    <dd class="col-sm-9">@(Model.Account.TwoFactorEnabled ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Recovery codes left</dt>
    <dd class="col-sm-9">@Model.Account.RecoveryCodesLeft</dd>
</dl>

<div class="border-top pt-4 mt-4">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h2 class="h5 mb-1">Multi-factor authentication</h2>
            <p class="text-muted mb-0">Use an authenticator app to protect account sign-in.</p>
        </div>
        <a class="btn btn-outline-primary" asp-page="/Account/Manage/Mfa">Manage MFA</a>
    </div>
</div>

<div class="border-top pt-4 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 mb-0">Sessions</h2>
        <form method="post" asp-page-handler="SignOutEverywhere">
            <button type="submit" class="btn btn-outline-danger">Sign out everywhere</button>
        </form>
    </div>

    @if (Model.Sessions.Count == 0)
    {
        <p class="text-muted">No sessions recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>Last seen</th>
                        <th>IP</th>
                        <th>Browser</th>
                        <th>OS</th>
                        <th>Device</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.Sessions)
                    {
                        <tr>
                            <td>@session.CreatedAtUtc.ToString("u")</td>
                            <td>@session.LastSeenAtUtc.ToString("u")</td>
                            <td>@(session.IpAddress ?? "Unknown")</td>
                            <td>@(session.Browser ?? "Unknown")</td>
                            <td>@(session.OperatingSystem ?? "Unknown")</td>
                            <td>@(session.Device ?? "Unknown")</td>
                            <td>
                                @if (session.IsCurrent)
                                {
                                    <span class="badge text-bg-primary me-1">Current</span>
                                }

                                @if (session.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else if (session.RevokedAtUtc is not null)
                                {
                                    <span class="badge text-bg-secondary">Revoked</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Expired</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
