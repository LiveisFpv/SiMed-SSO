@page
@model ConfirmEmailChangeModel

@{
    ViewData["Title"] = "Смена email";
}

<div class="text-center py-5">
    <h1 class="h3 mb-3">Смена email</h1>
    @if (Model.Succeeded)
    {
        <p class="text-muted mb-4">Email изменен.</p>
        <a class="btn btn-primary" asp-page="/Account/Manage">К аккаунту</a>
    }
    else
    {
        <p class="text-muted mb-4">Ссылка смены email недействительна или истекла.</p>
        <a class="btn btn-outline-primary" asp-page="/Account/Manage">К аккаунту</a>
    }
</div>
