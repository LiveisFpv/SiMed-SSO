@page
@model IndexModel

@{
    ViewData["Title"] = "Админка";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Админ-панель</h1>
        <p class="text-muted mb-0">Управление пользователями SSO, ролями и доступом приложений.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <h2 class="h5">Пользователи</h2>
            <p class="text-muted mb-3">Просмотр аккаунтов и их состояния.</p>
            <a class="btn btn-primary" asp-page="/Admin/Users/Index">Открыть пользователей</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <h2 class="h5">OAuth clients</h2>
            <p class="text-muted mb-3">Регистрация приложений для OAuth2-интеграции.</p>
            <a class="btn btn-primary" asp-page="/Admin/Clients/Index">Открыть clients</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <h2 class="h5">Безопасность</h2>
            <p class="text-muted mb-3">Контроль блокировок, подтверждения email и статуса MFA.</p>
            <a class="btn btn-primary disabled" aria-disabled="true">Позже</a>
        </div>
    </div>
</div>
