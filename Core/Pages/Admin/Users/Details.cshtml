@page
@model DetailsModel

@{
    ViewData["Title"] = "User details";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">User details</h1>
        <p class="text-muted mb-0">@Model.UserDetails.Email</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        <a class="btn btn-primary" asp-page="./EditRoles" asp-route-id="@Model.UserDetails.Id">Edit roles</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">User name</dt>
    <dd class="col-sm-9">@Model.UserDetails.UserName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.UserDetails.Email</dd>

    <dt class="col-sm-3">Roles</dt>
    <dd class="col-sm-9">
        @if (Model.UserDetails.Roles.Count > 0)
        {
            foreach (var role in Model.UserDetails.Roles)
            {
                <span class="badge text-bg-secondary me-1">@role</span>
            }
        }
        else
        {
            <span class="text-muted">No roles</span>
        }
    </dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@(Model.UserDetails.IsActive ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Locked out</dt>
    <dd class="col-sm-9">@(Model.UserDetails.IsLockedOut ? $"Yes, until {Model.UserDetails.LockoutEnd:u}" : "No")</dd>

    <dt class="col-sm-3">Email confirmed</dt>
    <dd class="col-sm-9">@(Model.UserDetails.EmailConfirmed ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(Model.UserDetails.PhoneNumber ?? "Not set")</dd>

    <dt class="col-sm-3">Phone confirmed</dt>
    <dd class="col-sm-9">@(Model.UserDetails.PhoneNumberConfirmed ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Two-factor enabled</dt>
    <dd class="col-sm-9">@(Model.UserDetails.TwoFactorEnabled ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Failed access count</dt>
    <dd class="col-sm-9">@Model.UserDetails.AccessFailedCount</dd>

    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.UserDetails.CreatedAtUtc.ToString("u")</dd>
</dl>

<div class="border-top pt-3">
    @if (Model.UserDetails.IsActive)
    {
        <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.UserDetails.Id">
            <button type="submit" class="btn btn-danger" disabled="@Model.UserDetails.IsCurrentUser">Deactivate user</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Reactivate" asp-route-id="@Model.UserDetails.Id">
            <button type="submit" class="btn btn-success">Reactivate user</button>
        </form>
    }
</div>

<div class="border-top pt-4 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 mb-0">Sessions</h2>
        <form method="post" asp-page-handler="RevokeSessions" asp-route-id="@Model.UserDetails.Id">
            <button type="submit" class="btn btn-outline-danger">Revoke all sessions</button>
        </form>
    </div>

    @if (Model.UserDetails.Sessions.Count == 0)
    {
        <p class="text-muted">No sessions recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>Last seen</th>
                        <th>IP</th>
                        <th>Browser</th>
                        <th>OS</th>
                        <th>Device</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model.UserDetails.Sessions)
                    {
                        <tr>
                            <td>@session.CreatedAtUtc.ToString("u")</td>
                            <td>@session.LastSeenAtUtc.ToString("u")</td>
                            <td>@(session.IpAddress ?? "Unknown")</td>
                            <td>@(session.Browser ?? "Unknown")</td>
                            <td>@(session.OperatingSystem ?? "Unknown")</td>
                            <td>@(session.Device ?? "Unknown")</td>
                            <td>
                                @if (session.IsCurrent)
                                {
                                    <span class="badge text-bg-primary me-1">Current</span>
                                }

                                @if (session.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else if (session.RevokedAtUtc is not null)
                                {
                                    <span class="badge text-bg-secondary">Revoked</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Expired</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
