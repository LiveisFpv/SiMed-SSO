@page
@model DetailsModel

@{
    ViewData["Title"] = "OAuth client details";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">OAuth client details</h1>
        <p class="text-muted mb-0">@Model.Client.DisplayName</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Client.Id">Edit</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

@if (TempData["CreatedClientId"] is string createdClientId &&
     TempData["CreatedClientSecret"] is string createdClientSecret)
{
    <div class="alert alert-warning" role="alert">
        <div class="fw-semibold mb-2">Client secret is shown once.</div>
        <dl class="mb-0">
            <dt>Client ID</dt>
            <dd><code>@createdClientId</code></dd>
            <dt>Client secret</dt>
            <dd><code>@createdClientSecret</code></dd>
        </dl>
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Client ID</dt>
    <dd class="col-sm-9"><code>@Model.Client.ClientId</code></dd>

    <dt class="col-sm-3">Display name</dt>
    <dd class="col-sm-9">@Model.Client.DisplayName</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Client.Description ?? "Not set")</dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@(Model.Client.IsActive ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Require PKCE</dt>
    <dd class="col-sm-9">@(Model.Client.RequirePkce ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Scopes</dt>
    <dd class="col-sm-9">
        @foreach (var scope in Model.Client.Scopes)
        {
            <span class="badge text-bg-secondary me-1">@scope</span>
        }
    </dd>

    <dt class="col-sm-3">Redirect URIs</dt>
    <dd class="col-sm-9">
        @foreach (var redirectUri in Model.Client.RedirectUris)
        {
            <div><code>@redirectUri</code></div>
        }
    </dd>

    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.Client.CreatedAtUtc.ToString("u")</dd>

    <dt class="col-sm-3">Updated</dt>
    <dd class="col-sm-9">@Model.Client.UpdatedAtUtc.ToString("u")</dd>
</dl>

<div class="border-top pt-3 d-flex gap-2">
    @if (Model.Client.IsActive)
    {
        <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Client.Id">
            <button type="submit" class="btn btn-outline-danger">Deactivate</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Reactivate" asp-route-id="@Model.Client.Id">
            <button type="submit" class="btn btn-outline-success">Reactivate</button>
        </form>
    }

    <form method="post" asp-page-handler="RotateSecret" asp-route-id="@Model.Client.Id">
        <button type="submit" class="btn btn-warning">Rotate secret</button>
    </form>
</div>
