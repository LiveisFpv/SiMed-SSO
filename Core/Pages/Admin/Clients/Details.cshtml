@page
@model DetailsModel

@{
    ViewData["Title"] = "Детали OAuth client";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Детали OAuth client</h1>
        <p class="text-muted mb-0">@Model.Client.DisplayName</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="./Index">Назад</a>
        <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Client.Id">Изменить</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

@if (TempData["CreatedClientId"] is string createdClientId &&
     TempData["CreatedClientSecret"] is string createdClientSecret)
{
    <div class="alert alert-warning" role="alert">
        <div class="fw-semibold mb-2">Client secret показывается только один раз.</div>
        <dl class="mb-0">
            <dt>Client ID</dt>
            <dd><code>@createdClientId</code></dd>
            <dt>Client secret</dt>
            <dd><code>@createdClientSecret</code></dd>
        </dl>
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Client ID</dt>
    <dd class="col-sm-9"><code>@Model.Client.ClientId</code></dd>

    <dt class="col-sm-3">Название</dt>
    <dd class="col-sm-9">@Model.Client.DisplayName</dd>

    <dt class="col-sm-3">Описание</dt>
    <dd class="col-sm-9">@(Model.Client.Description ?? "Не задано")</dd>

    <dt class="col-sm-3">Активен</dt>
    <dd class="col-sm-9">@(Model.Client.IsActive ? "Да" : "Нет")</dd>

    <dt class="col-sm-3">Требует PKCE</dt>
    <dd class="col-sm-9">@(Model.Client.RequirePkce ? "Да" : "Нет")</dd>

    <dt class="col-sm-3">Scopes</dt>
    <dd class="col-sm-9">
        @foreach (var scope in Model.Client.Scopes)
        {
            <span class="badge text-bg-secondary me-1">@scope</span>
        }
    </dd>

    <dt class="col-sm-3">Redirect URIs</dt>
    <dd class="col-sm-9">
        @foreach (var redirectUri in Model.Client.RedirectUris)
        {
            <div><code>@redirectUri</code></div>
        }
    </dd>

    <dt class="col-sm-3">Создал пользователь</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Client.CreatedByUserId) ? "Неизвестно" : Model.Client.CreatedByUserId)</dd>
</dl>

<div class="border-top pt-3 d-flex gap-2">
    @if (Model.Client.IsActive)
    {
        <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Client.Id">
            <button type="submit" class="btn btn-outline-danger">Деактивировать</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Reactivate" asp-route-id="@Model.Client.Id">
            <button type="submit" class="btn btn-outline-success">Реактивировать</button>
        </form>
    }

    <form method="post" asp-page-handler="RotateSecret" asp-route-id="@Model.Client.Id">
        <button type="submit" class="btn btn-warning">Сменить secret</button>
    </form>
</div>
