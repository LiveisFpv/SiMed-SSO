@page
@model IndexModel

@{
    ViewData["Title"] = "OAuth clients";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">OAuth clients</h1>
        <p class="text-muted mb-0">Manage registered applications that can integrate with SSO.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Index">Back</a>
        <a class="btn btn-primary" asp-page="./Create">Create client</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Client</th>
                <th>Scopes</th>
                <th>Redirect URIs</th>
                <th>Status</th>
                <th>State</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model.Clients)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@client.DisplayName</div>
                        <div class="text-muted small">@client.ClientId</div>
                    </td>
                    <td>
                        @foreach (var scope in client.Scopes)
                        {
                            <span class="badge text-bg-secondary me-1">@scope</span>
                        }
                    </td>
                    <td>
                        <span class="text-muted">@client.RedirectUris.Count URI(s)</span>
                    </td>
                    <td>
                        @if (client.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Inactive</span>
                        }

                        @if (client.RequirePkce)
                        {
                            <span class="badge text-bg-info">PKCE</span>
                        }
                    </td>
                    <td>@(client.IsActive ? "Active" : "Inactive")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="./Details" asp-route-id="@client.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@client.Id">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
